<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MatjesImager.Views"
             xmlns:ViewModels="clr-namespace:MatjesImager.ViewModels" x:Class="MatjesImager.Views.PreviewView"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=ViewModels:PreviewViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="400" d:DesignWidth="420">
    <!-- Step panel hosted by the shell. The DataContext is the PreviewViewModel provided by the shell's step list.
         Piezo and sheet positions are set with the shell's shared position controls -->
    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
    </UserControl.Resources>
    <StackPanel Margin="10">
        <TextBlock Text="Find sample" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="White" Text="{Binding StatusMessage}"/>

        <!-- Frame rate. The camera exposes for the whole frame period -->
        <TextBlock Text="Frame rate" Style="{StaticResource SectionHeader}"/>
        <StackPanel Orientation="Horizontal">
            <TextBox Width="60" Text="{Binding RequestedFrameRateHz, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                     ToolTip="Camera frame rate in Hz. The camera exposes for the whole frame period, so lower rates give brighter images"/>
            <TextBlock Text="Hz" VerticalAlignment="Center" Margin="4,0,12,0"/>
            <TextBlock VerticalAlignment="Center" Text="{Binding RequestedExposureMs, StringFormat='{}{0:F1} ms exposure'}"/>
            <Button Content="Apply" Padding="6,2" Margin="12,0,0,0" IsEnabled="{Binding CanApplyFrameRate}" Click="ApplyFrameRate_Click"/>
        </StackPanel>
        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11">
            <Run Text="Running at"/>
            <Run Text="{Binding FrameRateHz, Mode=OneWay}"/>
            <Run Text="Hz; the display shows about"/>
            <Run Text="{Binding Source={x:Static ViewModels:PreviewViewModel.DisplayRateHz}, Mode=OneWay}"/>
            <Run Text="frames per second."/>
        </TextBlock>

        <!-- Display -->
        <TextBlock Text="Display" Style="{StaticResource SectionHeader}"/>
        <Button Content="Auto contrast" Padding="6,2" HorizontalAlignment="Left" Click="AutoContrast_Click"
                ToolTip="Sets the display range from the pixel values of the latest frame. Fine-tune with the slider next to the image"/>

        <!-- Step completion -->
        <TextBlock Text="Done?" Style="{StaticResource SectionHeader}"/>
        <CheckBox Content="Sample found and both sheets in focus" IsChecked="{Binding IsSampleFound}"/>
    </StackPanel>
</UserControl>
