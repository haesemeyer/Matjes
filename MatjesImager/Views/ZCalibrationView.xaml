<Utils:WindowAwareView
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MatjesImager.Views"
             xmlns:ViewModels="clr-namespace:MatjesImager.ViewModels" x:Class="MatjesImager.Views.ZCalibrationView"
             xmlns:Utils="clr-namespace:MatjesUtils;assembly=MatjesUtils"
             mc:Ignorable="d" 
             d:DesignHeight="760" d:DesignWidth="1200">
    <Utils:WindowAwareView.Resources>
        <Utils:RoundDoubleConverter x:Key="RoundDoubleConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <ViewModels:ZCalibrationViewModel x:Key="DataSource"/>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
        <Style x:Key="NudgeButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
    </Utils:WindowAwareView.Resources>
    <Utils:WindowAwareView.DataContext>
        <Binding Source="{StaticResource DataSource}" x:Name="ViewModel" x:FieldModifier="public"/>
    </Utils:WindowAwareView.DataContext>
    <Grid Background="Gray">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- Position controls -->
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="10">
            <TextBlock Text="Objective piezo (um)" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
            <Slider Minimum="0" Maximum="{Binding Scanhead.PiezoRangeMicrons}" SmallChange="1" LargeChange="10" TickFrequency="50" TickPlacement="BottomRight"
                    Value="{Binding Scanhead.Piezo_Fixed_Microns}"/>
            <TextBox Width="80" HorizontalAlignment="Left" Text="{Binding Scanhead.Piezo_Fixed_Microns, StringFormat=F1}"/>

            <TextBlock Text="Sheet 1 z (V)" Style="{StaticResource SectionHeader}"/>
            <Slider Minimum="-2" Maximum="2" SmallChange="0.005" LargeChange="0.1" TickFrequency="0.5" TickPlacement="BottomRight"
                    Value="{Binding Scanhead.Z1_Fixed}"/>
            <StackPanel Orientation="Horizontal">
                <TextBox Width="80" Text="{Binding Scanhead.Z1_Fixed, StringFormat=F3}"/>
                <Button Content="-" Style="{StaticResource NudgeButton}" Click="Z1Down_Click" ToolTip="Fine step down"/>
                <Button Content="+" Style="{StaticResource NudgeButton}" Click="Z1Up_Click" ToolTip="Fine step up"/>
            </StackPanel>

            <TextBlock Text="Sheet 2 z (V)" Style="{StaticResource SectionHeader}"/>
            <Slider Minimum="-2" Maximum="2" SmallChange="0.005" LargeChange="0.1" TickFrequency="0.5" TickPlacement="BottomRight"
                    Value="{Binding Scanhead.Z2_Fixed}"/>
            <StackPanel Orientation="Horizontal">
                <TextBox Width="80" Text="{Binding Scanhead.Z2_Fixed, StringFormat=F3}"/>
                <Button Content="-" Style="{StaticResource NudgeButton}" Click="Z2Down_Click" ToolTip="Fine step down"/>
                <Button Content="+" Style="{StaticResource NudgeButton}" Click="Z2Up_Click" ToolTip="Fine step up"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Fine step (V)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Width="60" Text="{Binding ZStepVolts}"/>
            </StackPanel>
            <CheckBox Content="Sheets follow fit when piezo moves" Margin="0,6,0,0" IsChecked="{Binding FollowFit}"
                      ToolTip="Once two points are set, moving the piezo places both sheets at their predicted focus"/>

            <TextBlock Text="Sheet extents (V)" Style="{StaticResource SectionHeader}"/>
            <TextBlock Text="Sheet 1"/>
            <Utils:RangeSlider Minimum="-3" Maximum="3" ShowRangeText="True" DefaultLowerValue="0" DefaultUpperValue="0"
                               LowerValue="{Binding Scanhead.Sheet1LeftVolts}" UpperValue="{Binding Scanhead.Sheet1RightVolts}"/>
            <TextBlock Text="Sheet 2"/>
            <Utils:RangeSlider Minimum="-1" Maximum="1" ShowRangeText="True" DefaultLowerValue="0" DefaultUpperValue="0" FineAdjustmentFactor="0.05"
                               LowerValue="{Binding Scanhead.Sheet2LeftVolts}" UpperValue="{Binding Scanhead.Sheet2RightVolts}"/>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Frame rate: "/>
                <TextBlock Text="{Binding Camera.FrameRate, ConverterParameter=2, Converter={StaticResource RoundDoubleConverter}}"/>
                <TextBlock Text="  Frame: "/>
                <TextBlock Text="{Binding Camera.FrameIndex}"/>
            </StackPanel>
        </StackPanel>

        <!-- Live camera image and display scaling -->
        <Utils:EZImage Grid.Row="0" Grid.Column="1" Margin="5" Source="{Binding Camera.Display, Mode=OneWay}"/>
        <Utils:RangeSlider Grid.Row="0" Grid.Column="2" Margin="5,20" VerticalAlignment="Stretch" IsVertical="True" Maximum="65535"
                           LowerValue="{Binding Camera.ImageScaleMin}" UpperValue="{Binding Camera.ImageScaleMax}" ShowRangeText="True"
                           RangeTextFormat="{}{0:0} - {1:0}" MinimumRange="10" DefaultUpperValue="65535" DefaultLowerValue="0" FineAdjustmentFactor="0.05"/>

        <!-- Fit display -->
        <StackPanel Grid.Row="0" Grid.Column="3" Margin="10">
            <TextBlock Text="Calibration fit" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
            <Utils:FitPlot Height="240" Points1="{Binding Sheet1PlotPoints}" Points2="{Binding Sheet2PlotPoints}"
                           Fit1="{Binding Fit1}" Fit2="{Binding Fit2}" XLabel="Piezo (um)" YLabel="V"/>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Sheet 1" Foreground="DodgerBlue" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Sheet 2" Foreground="OrangeRed" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Slope (V/um)" Margin="0,0,8,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Fit1.Slope, StringFormat={}{0:F5}, FallbackValue=-, TargetNullValue=-}"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Fit2.Slope, StringFormat={}{0:F5}, FallbackValue=-, TargetNullValue=-}"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Offset (V)" Margin="0,0,8,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Fit1.Offset, StringFormat={}{0:F3}, FallbackValue=-, TargetNullValue=-}"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Fit2.Offset, StringFormat={}{0:F3}, FallbackValue=-, TargetNullValue=-}"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="R²" Margin="0,0,8,0"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Fit1.RSquared, StringFormat={}{0:F4}, FallbackValue=-, TargetNullValue=-}"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Fit2.RSquared, StringFormat={}{0:F4}, FallbackValue=-, TargetNullValue=-}"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Flag residuals above (um)" VerticalAlignment="Center" Margin="0,0,6,0"
                           ToolTip="About a quarter of the sheet thickness"/>
                <TextBox Width="50" Text="{Binding ResidualWarningMicrons}"/>
            </StackPanel>
            <Button Content="Accept calibration" Margin="0,10,0,0" Padding="4" IsEnabled="{Binding CanAccept}" Click="Accept_Click"/>
        </StackPanel>

        <!-- Calibration point slots -->
        <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="5" ItemsSource="{Binding CalibrationPoints}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type ViewModels:CalibrationPoint}">
                    <Border Margin="4" Padding="4" Background="DimGray" BorderThickness="2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResidualWarning}" Value="True">
                                        <Setter Property="BorderBrush" Value="Red"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding Index, StringFormat='Point {0}'}" FontWeight="SemiBold" Foreground="White"/>
                            <Grid Height="140">
                                <Utils:EZImage Source="{Binding Snapshot, Mode=OneWay}"/>
                                <TextBlock Text="empty" Foreground="LightGray" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSet}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <StackPanel Visibility="{Binding IsSet, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Foreground="White" Text="{Binding PiezoMicrons, StringFormat='Piezo: {0:F1} um'}"/>
                                <TextBlock Foreground="White">
                                    <Run Text="{Binding Z1Volts, StringFormat='Z1: {0:F3} V', Mode=OneWay}"/>
                                    <Run Text="{Binding Z2Volts, StringFormat='Z2: {0:F3} V', Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Foreground="White">
                                    <Run Text="Residual (um):"/>
                                    <Run Text="{Binding Residual1Microns, StringFormat=F1, Mode=OneWay}"/>
                                    <Run Text="/"/>
                                    <Run Text="{Binding Residual2Microns, StringFormat=F1, Mode=OneWay}"/>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="Go to" Padding="4,0" Click="GoToPoint_Click" ToolTip="Move piezo and sheets to this point"/>
                                    <Button Content="Clear" Padding="4,0" Margin="4,0,0,0" Click="ClearPoint_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Actions and status -->
        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="10,0,10,10">
            <Button Content="Add calibration point" Padding="6,2" IsEnabled="{Binding CanAddPoint}" Click="AddPoint_Click"/>
            <Button Content="Clear all" Padding="6,2" Margin="8,0,0,0" Click="ClearAll_Click"/>
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="White" Text="{Binding StatusMessage}"/>
        </StackPanel>
    </Grid>
</Utils:WindowAwareView>
