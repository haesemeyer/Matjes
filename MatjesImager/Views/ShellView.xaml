<Utils:WindowAwareView
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MatjesImager.Views"
             xmlns:ViewModels="clr-namespace:MatjesImager.ViewModels" x:Class="MatjesImager.Views.ShellView"
             xmlns:Utils="clr-namespace:MatjesUtils;assembly=MatjesUtils"
             mc:Ignorable="d" 
             d:DesignHeight="860" d:DesignWidth="1400">
    <Utils:WindowAwareView.Resources>
        <Utils:RoundDoubleConverter x:Key="RoundDoubleConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <ViewModels:ShellViewModel x:Key="DataSource"/>
        <!-- The panel of each step type. WPF recreates these visuals on each switch, all state lives in the step view models -->
        <DataTemplate DataType="{x:Type ViewModels:ZCalibrationViewModel}">
            <local:ZCalibrationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ViewModels:PlaceholderStepViewModel}">
            <StackPanel Margin="10">
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="White" Text="{Binding Description}"/>
            </StackPanel>
        </DataTemplate>
    </Utils:WindowAwareView.Resources>
    <Utils:WindowAwareView.DataContext>
        <Binding Source="{StaticResource DataSource}" x:Name="ViewModel" x:FieldModifier="public"/>
    </Utils:WindowAwareView.DataContext>
    <Grid Background="Gray">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="440"/>
        </Grid.ColumnDefinitions>

        <!-- Step list and the shared position controls -->
        <ScrollViewer Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <ListBox ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}" Background="DimGray" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type ViewModels:StepViewModel}">
                            <Grid Width="190" Margin="0,3" ToolTip="{Binding StateHint}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Number}" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="White"/>
                                <TextBlock Grid.Column="2" FontWeight="Bold" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value=""/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Done">
                                                    <Setter Property="Text" Value="✓"/>
                                                    <Setter Property="Foreground" Value="LightGreen"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="NeedsAttention">
                                                    <Setter Property="Text" Value="!"/>
                                                    <Setter Property="Foreground" Value="Orange"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border Margin="0,8,0,0" Visibility="{Binding SelectedStep.UsesPositionControls, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                    <local:PositionsView DataContext="{Binding Positions}"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Shared live camera image and display scaling -->
        <Utils:EZImage Grid.Row="0" Grid.Column="1" Margin="5" Source="{Binding LightSheet.Camera.Display, Mode=OneWay}"/>
        <Utils:RangeSlider Grid.Row="0" Grid.Column="2" Margin="5,20" VerticalAlignment="Stretch" IsVertical="True" Maximum="65535"
                           LowerValue="{Binding LightSheet.Camera.ImageScaleMin}" UpperValue="{Binding LightSheet.Camera.ImageScaleMax}" ShowRangeText="True"
                           RangeTextFormat="{}{0:0} - {1:0}" MinimumRange="10" DefaultUpperValue="65535" DefaultLowerValue="0" FineAdjustmentFactor="0.05"/>

        <!-- Panel of the selected step -->
        <ScrollViewer Grid.Row="0" Grid.Column="3" VerticalScrollBarVisibility="Auto">
            <ContentControl Content="{Binding SelectedStep}"/>
        </ScrollViewer>

        <!-- Status bar -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Background="DimGray" Padding="10,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="White" Text="Mode: "/>
                <TextBlock Foreground="White" FontWeight="SemiBold" Text="{Binding LightSheet.Mode}"/>
                <TextBlock Foreground="White" Text="   Frame rate: "/>
                <TextBlock Foreground="White" Text="{Binding LightSheet.Camera.FrameRate, ConverterParameter=2, Converter={StaticResource RoundDoubleConverter}, FallbackValue=-, TargetNullValue=-}"/>
                <TextBlock Foreground="White" Text="   Frame: "/>
                <TextBlock Foreground="White" Text="{Binding LightSheet.Camera.FrameIndex, FallbackValue=-, TargetNullValue=-}"/>
                <TextBlock Foreground="White" Text="   Piezo: "/>
                <TextBlock Foreground="White" Text="{Binding LightSheet.ScanHead.Piezo_Fixed_Microns, StringFormat='{}{0:F1} um'}"/>
                <TextBlock Foreground="Orange" Margin="20,0,0,0" Text="{Binding StatusMessage}"/>
            </StackPanel>
        </Border>
    </Grid>
</Utils:WindowAwareView>
