<Utils:WindowAwareView
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MatjesImager.Views"
             xmlns:ViewModels="clr-namespace:MatjesImager.ViewModels" x:Class="MatjesImager.Views.TestView"
             xmlns:Utils="clr-namespace:MatjesUtils;assembly=MatjesUtils"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Utils:WindowAwareView.Resources>
        <Utils:NumberAddUnitConverter x:Key="NumberAddUnitConverter"/>
        <Utils:RoundDoubleConverter x:Key="RoundDoubleConverter"/>
        <ViewModels:TestViewModel x:Key="DataSource"/>
    </Utils:WindowAwareView.Resources>
    <Utils:WindowAwareView.DataContext>
        <Binding Source="{StaticResource DataSource}" x:Name="ViewModel" x:FieldModifier="public"/>
    </Utils:WindowAwareView.DataContext>
    <Grid Background="Gray">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="263*"/>
            <ColumnDefinition Width="537*"/>
        </Grid.ColumnDefinitions>
        <Utils:EZImage HorizontalAlignment="Left" VerticalAlignment="Center" Height="430" Width="431" Margin="96,0,0,0" Source="{Binding CamDisplay, Mode=OneWay}" Grid.Column="1"/>
        <Label Content="Sheet 1" HorizontalAlignment="Left" Margin="17,26,0,0" VerticalAlignment="Top"/>
        <Label Content="Sheet 2" HorizontalAlignment="Left" Margin="17,94,0,0" VerticalAlignment="Top"/>
        <Slider x:Name="Z_Pos_2" HorizontalAlignment="Left" Margin="213,241,0,0" VerticalAlignment="Top" Width="33" Orientation="Vertical" Height="104" Maximum="2" Minimum="-2" TickFrequency="0.5" TickPlacement="BottomRight" LargeChange="0.5" Value="{Binding Scanhead.Z2_Fixed}"/>
        <Slider x:Name="Z_Pos_1" HorizontalAlignment="Left" Margin="157,241,0,0" VerticalAlignment="Top" Width="33" Orientation="Vertical" Height="104" Maximum="2" Minimum="-2" TickFrequency="0.5" TickPlacement="BottomRight" LargeChange="0.5" Value="{Binding Scanhead.Z1_Fixed}"/>
        <Label Content="{Binding Scanhead.Z1_Fixed, ConverterParameter=2, Converter={StaticResource RoundDoubleConverter}}" HorizontalAlignment="Left" Margin="147,343,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.832,0.452"/>
        <Label Content="{Binding Scanhead.Z2_Fixed, ConverterParameter=2, Converter={StaticResource RoundDoubleConverter}}" HorizontalAlignment="Left" Margin="203,343,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.832,0.452"/>
        <Label Content="Z1" HorizontalAlignment="Left" Margin="158,215,0,0" VerticalAlignment="Top"/>
        <Label Content="Z2&#xD;&#xA;" HorizontalAlignment="Left" Margin="212,215,0,0" VerticalAlignment="Top"/>
        <Slider x:Name="Piezo_Pos" HorizontalAlignment="Left" Margin="17,241,0,0" VerticalAlignment="Top" Width="33" Orientation="Vertical" Height="104" TickFrequency="50" TickPlacement="BottomRight" LargeChange="10" IsDirectionReversed="True" Value="{Binding Scanhead.Piezo_Fixed_Microns}" Maximum="450" SmallChange="1"/>
        <Label Content="Piezo" HorizontalAlignment="Left" Margin="8,0,0,0" VerticalAlignment="Center"/>
        <Label HorizontalAlignment="Left" Margin="9,343,0,0" VerticalAlignment="Top" RenderTransformOrigin="3.658,1.116" Content="{Binding Scanhead.Piezo_Fixed_Microns, ConverterParameter=uM, Converter={StaticResource NumberAddUnitConverter}}"/>
        <Label Content="{Binding FrameIndex}" HorizontalAlignment="Left" Margin="187,424,0,0" VerticalAlignment="Top" Width="74" FontSize="10"/>
        <Label Content="{Binding FrameRate, ConverterParameter=2, Converter={StaticResource RoundDoubleConverter}}" HorizontalAlignment="Left" Margin="39,424,0,0" VerticalAlignment="Top" FontSize="10" Background="#FFECAB1C" Width="52"/>
        <Utils:RangeSlider Grid.Column="1" HorizontalAlignment="Left" Margin="10,145,0,0" VerticalAlignment="Top" Height="165" IsVertical="True" Maximum="65535" LowerValue="{Binding ImageScaleMin}" UpperValue="{Binding ImageScaleMax}" ShowRangeText="True" RangeTextFormat="{}{0:0} - {1:0}" MinimumRange="10" DefaultUpperValue="65535" DefaultLowerValue="0" FineAdjustmentFactor="0.05"/>
        <Utils:RangeSlider HorizontalAlignment="Left" Margin="17,48,0,0" VerticalAlignment="Top" Width="169" DefaultLowerValue="0" DefaultUpperValue="0" Maximum="3" Minimum="-3" ShowRangeText="True" LowerValue="{Binding Scanhead.Sheet1LeftVolts}" UpperValue="{Binding Scanhead.Sheet1RightVolts}"/>
        <Utils:RangeSlider HorizontalAlignment="Left" Margin="17,113,0,0" VerticalAlignment="Top" Width="169" DefaultLowerValue="0" DefaultUpperValue="0" Maximum="1" Minimum="-1" ShowRangeText="True" LowerValue="{Binding Sheet2LeftVolts}" UpperValue="{Binding Scanhead.Sheet2RightVolts}" FineAdjustmentFactor="0.05"/>


    </Grid>
</Utils:WindowAwareView>
